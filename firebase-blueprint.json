{
  "entities": {
    "Employee": {
      "title": "Employee",
      "description": "Master employee personnel and duty roster record for LEEDO staff",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "banglaName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "gender": { "type": "string" },
        "dob": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "nidOrPassport": { "type": "string" },
        "avatar": { "type": "string" },
        "presentAddress": { "type": "string" },
        "permanentAddress": { "type": "string" },
        "designation": { "type": "string" },
        "department": { "type": "string" },
        "gradeLevel": { "type": "string" },
        "joiningDate": { "type": "string" },
        "employmentType": { "type": "string" },
        "status": { "type": "string" },
        "workStation": { "type": "string" },
        "assignedProject": { "type": "string" },
        "jobLocations": { "type": "array" },
        "dutyDays": { "type": "array" },
        "shiftStartTime": { "type": "string" },
        "shiftEndTime": { "type": "string" },
        "dailyDutyHours": { "type": "number" },
        "weeklyDutyDaysCount": { "type": "number" },
        "casualLeaveQuota": { "type": "number" },
        "sickLeaveQuota": { "type": "number" },
        "grossSalary": { "type": "number" },
        "basicSalary": { "type": "number" },
        "houseRent": { "type": "number" },
        "medicalAllowance": { "type": "number" },
        "conveyanceAllowance": { "type": "number" },
        "mobileAllowance": { "type": "number" },
        "travelAllowance": { "type": "number" },
        "advanceBalance": { "type": "number" },
        "pfDeductionPercentage": { "type": "number" },
        "taxDeduction": { "type": "number" },
        "reportingManagerId": { "type": "string" },
        "reportingManagerName": { "type": "string" }
      },
      "required": ["id", "fullName", "email", "designation", "department", "status"]
    },
    "Timesheet": {
      "title": "Timesheet",
      "description": "Monthly staff roster and project duty timesheet logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "weekStarting": { "type": "string" },
        "projectCode": { "type": "string" },
        "projectName": { "type": "string" },
        "activityDescription": { "type": "string" },
        "hours": { "type": "object" },
        "totalHours": { "type": "number" },
        "status": { "type": "string" },
        "supervisorComment": { "type": "string" },
        "correctionRequests": { "type": "array" }
      },
      "required": ["id", "employeeId", "employeeName", "weekStarting", "projectCode", "totalHours", "status"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily punch, GPS coordinates, and field work logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "date": { "type": "string" },
        "clockInTime": { "type": "string" },
        "clockOutTime": { "type": "string" },
        "workMode": { "type": "string" },
        "punchLocationName": { "type": "string" },
        "locationNote": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "employeeId", "date", "clockInTime", "status"]
    },
    "LeaveRequest": {
      "title": "LeaveRequest",
      "description": "Leave application with supervisor recommendation and HR approval",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "department": { "type": "string" },
        "leaveType": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "daysCount": { "type": "number" },
        "reason": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "employeeId", "leaveType", "startDate", "endDate", "status"]
    },
    "Payroll": {
      "title": "Payroll",
      "description": "Monthly salary record and payslip",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "monthKey": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "grossSalary": { "type": "number" },
        "netSalary": { "type": "number" },
        "paymentStatus": { "type": "string" }
      },
      "required": ["id", "monthKey", "employeeId", "netSalary", "paymentStatus"]
    },
    "Separation": {
      "title": "Separation",
      "description": "Staff separation, clearance, and final settlement record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "separationType": { "type": "string" },
        "lastWorkingDate": { "type": "string" },
        "reason": { "type": "string" },
        "settlementAmount": { "type": "number" },
        "clearanceStatus": { "type": "string" }
      },
      "required": ["id", "employeeId", "separationType", "lastWorkingDate", "clearanceStatus"]
    },
    "CompanySettings": {
      "title": "CompanySettings",
      "description": "LEEDO organization settings, active centers and job locations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyName": { "type": "string" },
        "logoUrl": { "type": "string" },
        "jobLocations": { "type": "array" }
      },
      "required": ["id"]
    },
    "GovernmentHoliday": {
      "title": "GovernmentHoliday",
      "description": "Official Bangladesh national, religious, and executive order government holidays",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "titleBangla": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "daysCount": { "type": "number" },
        "type": { "type": "string" },
        "description": { "type": "string" },
        "isGazetted": { "type": "boolean" },
        "year": { "type": "number" }
      },
      "required": ["id", "title", "startDate", "endDate", "daysCount", "type", "year"]
    }
  },
  "firestore": {
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Master employee and duty roster records"
    },
    "/timesheets/{timesheetId}": {
      "schema": "Timesheet",
      "description": "Monthly duty logs and project timesheets"
    },
    "/attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Daily attendance logs"
    },
    "/leaves/{leaveId}": {
      "schema": "LeaveRequest",
      "description": "Staff leave applications and supervisor recommendations"
    },
    "/holidays/{holidayId}": {
      "schema": "GovernmentHoliday",
      "description": "Official government and gazetted public holidays"
    },
    "/payroll/{payrollId}": {
      "schema": "Payroll",
      "description": "Monthly payroll entries"
    },
    "/separations/{separationId}": {
      "schema": "Separation",
      "description": "Staff resignation, exit clearance and final settlement"
    },
    "/company_settings/{settingId}": {
      "schema": "CompanySettings",
      "description": "Organization profile and job location centers"
    }
  }
}
